@page "{id:int}"
@model DetailModel
@{
    ViewData["Title"] = "Detail přihlášky";
}

<h1>Detail přihlášky #@Model.Subscription!.Id</h1>

<dl class="row">
    <dt class="col-sm-3">Jméno</dt>
    <dd class="col-sm-9">@Model.Subscription.Name</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Subscription.Email</dd>

    <dt class="col-sm-3">Kurz</dt>
    <dd class="col-sm-9">@Model.Subscription.Course</dd>
</dl>

<a asp-page="/List" class="btn btn-secondary">Zpět na seznam</a>
