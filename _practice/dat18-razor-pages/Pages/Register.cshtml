@page "{email?}"
@model dat18_razor_pages.Pages.RegisterModel
@{
}

<h1>Registrace</h1>
<form method="post">
    <div>
        <label asp-for="Jmeno">Jméno</label>
        <input asp-for="Jmeno" />
        <span asp-validation-for="Jmeno"></span>
    </div>
    <div>
        <label asp-for="Prijmeni">Příjmení</label>
        <input asp-for="Prijmeni" />
        <span asp-validation-for="Prijmeni"></span>
    </div>
    <div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label asp-for="Kurz">Zvolený kurz</label>
        <select asp-for="Kurz" asp-items="@(new SelectList(Model.Kurzy))">
            <option value="">-- Zvolte kurz --</option>
        </select>
    </div>
    <button type="submit">Odeslat</button>
</form>