@page
@model dat18_warmup_contact.Pages.ContactModel
@{

}
<h1>Kontakt</h1>
 <form method="post">
    <div class="mb-3">
        <label asp-for="Input.Name">Jméno</label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
     </div>
    <div class="mb-3">
         <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" class="form-control" />
         <span asp-validation-for="Input.Email" class="text-danger"></span>
     </div>
    <div class="mb-3">
         <label asp-for="Input.Subject">Typ požadavku</label>
        <select asp-for="Input.Subject" asp-items="@(new SelectList(Model.Subjects))" class="form-select">
             <option value="">-- Vyber předmět --</option>
         </select>
     </div>
    <div class="mb-3">
         <label asp-for="Input.Message">Zpráva</label>
        <textarea asp-for="Input.Message" rows="5" class="form-control"></textarea>
        <span asp-validation-for="Input.Message" class="text-danger"></span>
     </div>
    <button type="submit" class="btn btn-primary">Odeslat</button>
 </form>